# Cashfree Payment Gateway
# Get these from the Cashfree merchant dashboard (Developers > API Keys).
# Use sandbox keys while testing, switch CASHFREE_ENV to "production" to go live.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# Public site URL — used to build the Cashfree return_url after checkout.
# Set to the real domain (e.g. https://azisly.ai) before going live.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must match CASHFREE_ENV — the client-side SDK also needs to know the mode.
NEXT_PUBLIC_CASHFREE_MODE=sandbox
