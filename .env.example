# Cashfree Payment Gateway
# Get these from the Cashfree merchant dashboard (Developers > API Keys).
# Use sandbox keys while testing, switch CASHFREE_ENV to "production" to go live.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# Public site URL — used to build the Cashfree return_url after checkout.
# Set to the real domain (e.g. https://azisly.ai) before going live.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must match CASHFREE_ENV — the client-side SDK also needs to know the mode.
NEXT_PUBLIC_CASHFREE_MODE=sandbox

# Welcome email (sent automatically 5 minutes after a successful payment)
# Cashfree webhook URL to register in the Cashfree dashboard:  <site>/api/webhooks/cashfree
RESEND_API_KEY=
EMAIL_FROM=Azisly <hello@azisly.ai>
EMAIL_REPLY_TO=
EMAIL_DELAY_MINUTES=5
EMAIL_ZOOM_URL=
EMAIL_WHATSAPP_URL=
EMAIL_AZISLY_URL=https://azisly.ai
EMAIL_CREDIT_CODE_COLLEGE=
EMAIL_CREDIT_CODE_CORPORATE=
# optional: one entry per class, "|" separated, e.g. "Thu 15 Oct, 7 PM|Fri 16 Oct, 7 PM|..."
EMAIL_CLASS_DATES=
EMAIL_SUPPORT_EMAIL=support@azisly.ai
